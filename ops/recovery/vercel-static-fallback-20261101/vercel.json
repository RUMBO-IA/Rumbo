{
  "version": 2,
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/refund",
      "destination": "/refund.html"
    },
    {
      "source": "/security",
      "destination": "/security.html"
    },
    {
      "source": "/trust-center",
      "destination": "/trust-center.html"
    },
    {
      "source": "/status",
      "destination": "/status.html"
    },
    {
      "source": "/openai-support",
      "destination": "/openai-support.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
