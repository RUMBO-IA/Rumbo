{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumbo.verso.fans/schemas/content-approval-receipt-v1.json",
  "title": "RUMBO IA Content Approval Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item_id",
    "decision",
    "content_sha256",
    "review_packet_ref",
    "target_channels",
    "reviewer",
    "reviewed_at",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "const": "APPROVED"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_packet_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "explicit_human_approval"
    },
    "notes": {
      "type": "string"
    }
  }
}
