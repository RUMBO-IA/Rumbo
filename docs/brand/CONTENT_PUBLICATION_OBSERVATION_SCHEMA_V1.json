{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumbo.verso.fans/schemas/content-publication-observation-v1.json",
  "title": "RUMBO IA Content Publication Observation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "item_id", "channel", "content_sha256", "account_identity",
    "provider", "provider_request_id", "provider_job_id", "account_binding_ref",
    "remote_records", "authority_chain_state", "canonical_promotion"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "item_id": {"type": "string", "minLength": 1},
    "channel": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "account_identity": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "provider_request_id": {"type": "string", "minLength": 1},
    "provider_job_id": {"type": "string", "minLength": 1},
    "account_binding_ref": {"const": "docs/brand/distribution_lock_v1.json"},
    "remote_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/remote_record"}},
    "authority_chain_state": {"const": "OBSERVED_REMOTE_EFFECT_OUTSIDE_COMPLETE_CANONICAL_AUTHORITY_CHAIN"},
    "canonical_promotion": {"const": "NO_GO"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "remote_record": {
      "type": "object", "additionalProperties": false,
      "required": ["remote_id", "remote_url", "published_at", "readback_at", "readback_status", "record_role"],
      "properties": {
        "remote_id": {"type": "string", "minLength": 1},
        "remote_url": {"type": "string", "format": "uri"},
        "published_at": {"type": "string", "format": "date-time"},
        "readback_at": {"type": "string", "format": "date-time"},
        "readback_status": {"const": "PASS"},
        "record_role": {"enum": ["ROOT", "ADDITIONAL_REMOTE_RECORD"]}
      }
    }
  }
}
