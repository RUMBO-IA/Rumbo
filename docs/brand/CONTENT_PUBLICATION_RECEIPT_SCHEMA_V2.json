{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumbo.verso.fans/schemas/content-publication-receipt-v2.json",
  "title": "RUMBO IA Content Publication Receipt V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "item_id", "status", "content_sha256", "distribution_lock_sha256",
    "approval_receipt_ref", "publication_authorization_receipt_ref", "review_packet_ref",
    "target_channels", "publications", "publisher", "source"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "item_id": {"type": "string", "minLength": 1},
    "status": {"const": "PUBLISHED"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "distribution_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_receipt_ref": {"type": "string", "minLength": 1},
    "publication_authorization_receipt_ref": {"type": "string", "minLength": 1},
    "review_packet_ref": {"type": "string", "minLength": 1},
    "target_channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "publications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/channel_publication"}},
    "publisher": {"type": "string", "minLength": 1},
    "source": {"const": "authenticated_publication_action"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "channel_publication": {
      "type": "object", "additionalProperties": false,
      "required": ["channel", "account_identity", "provider", "provider_request_id", "provider_job_id", "account_binding_ref", "remote_records"],
      "properties": {
        "channel": {"type": "string", "minLength": 1},
        "account_identity": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "provider_request_id": {"type": "string", "minLength": 1},
        "provider_job_id": {"type": "string", "minLength": 1},
        "account_binding_ref": {"const": "docs/brand/distribution_lock_v1.json"},
        "remote_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/remote_record"}}
      }
    },
    "remote_record": {
      "type": "object", "additionalProperties": false,
      "required": ["remote_id", "remote_url", "published_at", "readback_at", "readback_status", "record_role"],
      "properties": {
        "remote_id": {"type": "string", "minLength": 1},
        "remote_url": {"type": "string", "format": "uri"},
        "published_at": {"type": "string", "format": "date-time"},
        "readback_at": {"type": "string", "format": "date-time"},
        "readback_status": {"const": "PASS"},
        "record_role": {"enum": ["ROOT", "ADDITIONAL_REMOTE_RECORD"]}
      }
    }
  }
}
