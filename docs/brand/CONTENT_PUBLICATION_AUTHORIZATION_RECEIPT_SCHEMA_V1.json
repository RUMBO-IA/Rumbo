{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumbo.verso.fans/schemas/content-publication-authorization-receipt-v1.json",
  "title": "RUMBO IA Content Publication Authorization Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item_id",
    "decision",
    "content_sha256",
    "approval_receipt_ref",
    "target_channels",
    "authorizer",
    "authorized_at",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "const": "AUTHORIZE_PUBLICATION"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval_receipt_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorizer": {
      "type": "string",
      "minLength": 1
    },
    "authorized_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "explicit_human_publication_authorization"
    },
    "notes": {
      "type": "string"
    }
  }
}
